<?xml version="1.0" encoding="UTF-8"?>
<!-- One source tree, two Spring Boot lines:
       mvn -Pboot3 package   -> Spring Boot 3.5 (Spring Framework 6.2), runs on Java 17+
       mvn -Pboot4 package   -> Spring Boot 4.1 (Spring Framework 7.0), runs on Java 17+
     Both compile with release 17, so the same jar runs on Java 17 and Java 25. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>demo</groupId>
  <artifactId>fanout</artifactId>
  <version>1.0</version>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <profiles>
    <profile>
      <id>boot3</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><boot.version>3.5.16</boot.version><jar.suffix>boot3</jar.suffix></properties>
    </profile>
    <profile>
      <id>boot4</id>
      <properties><boot.version>4.1.2</boot.version><jar.suffix>boot4</jar.suffix></properties>
    </profile>
  </profiles>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <finalName>fanout-${jar.suffix}</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${boot.version}</version>
        <executions><execution><goals><goal>repackage</goal></goals></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
